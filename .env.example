# Flipkart Review API — Environment Configuration
# Copy this file to .env and customize values for your environment.
# The application reads these with os.environ.get(); no secrets are required.

# Server settings
PORT=5000
HOST=0.0.0.0

# Flask settings
# Set to "true" ONLY in local development — never in production
FLASK_DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

